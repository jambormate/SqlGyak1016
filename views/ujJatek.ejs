<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Új játék felvétele</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
        <h1>Új játék felvétele</h1>
        <form action="/ujJatek" method="post">
            <div>
                <label for="nev" class="form-label">Játék neve</label>
                <input type="text" id="nev" name="nev" class="form-control" value="<%= nev %>">
            </div>
            <button type="submit" class="btn btn-primary">Mentés</button>
        </form>

        <% if (hiba) { %>
            <p class="alert alert-danger" role="alert"><%= hiba %></p>
        <% } %>

        <% if (letrehozottJatek) { %>
            <div class="alert alert-success" role="status">
                <h2>A játék sikeresen létrejött</h2>
                <p>Azonosító: <%= letrehozottJatek.id %></p>
                <p>Név: <%= letrehozottJatek.nev %></p>
            </div>
        <% } %>
</body>
</html>